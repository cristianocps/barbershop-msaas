# ─────────────────────────────────────────────────────────────
# Variáveis de ambiente para o Portainer Stack
# NO PORTAINER: cole cada linha abaixo na seção "Environment variables"
# ─────────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=qwas7845
POSTGRES_DB=barbershop_prod_db

# JWT
JWT_SECRET=abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-._@+

# Seed — usuários iniciais (opcional; padrões no appsettings.json)
# SEED_ADMIN_EMAIL=admin@demo.barbershop
# SEED_ADMIN_PASSWORD=Admin@123
# SEED_DESENVOLVEDOR_EMAIL=dev@barbershop.platform
# SEED_DESENVOLVEDOR_PASSWORD=Dev@123

# URL da API — vista pelo NAVEGADOR do usuário (domínio público do backend)
# O frontend (barbershopp.com.br) chama o backend nessa URL
VITE_API_URL=http://barbershopp.com.br:5508

# Infinite Pay — fallback global (opcional; o ideal é configurar por loja em Configurações → Infinite Pay)
INFINITEPAY_HANDLE=
INFINITEPAY_WEBHOOK_SECRET=
# Opcional — padrões apontam para app.barbershopp.com.br (Traefik + proxy /api)
# INFINITEPAY_CHECKOUT_API_URL=https://api.checkout.infinitepay.io
# INFINITEPAY_REDIRECT_URL_BASE=https://app.barbershopp.com.br/agendamentos/pagamento-retorno
# INFINITEPAY_WEBHOOK_URL=https://app.barbershopp.com.br/api/webhooks/infinitepay
# INFINITEPAY_TAP_RESULT_URL_BASE=https://app.barbershopp.com.br/agendamentos/tap-retorno
# INFINITEPAY_APP_CLIENT_REFERRER=BarberShop

# Cobrança da plataforma (conta Infinite Pay do dono do SaaS)
PLATAFORMA_INFINITEPAY_HANDLE=
PLATAFORMA_INFINITEPAY_WEBHOOK_SECRET=
# PLATAFORMA_INFINITEPAY_CHECKOUT_API_URL=https://api.checkout.infinitepay.io
# PLATAFORMA_INFINITEPAY_REDIRECT_URL_BASE=https://app.barbershopp.com.br/assinatura/retorno
# PLATAFORMA_INFINITEPAY_WEBHOOK_URL=https://app.barbershopp.com.br/api/webhooks/infinitepay/plataforma
PLATAFORMA_MENSALIDADE_CENTAVOS=9900
PLATAFORMA_TRIAL_DIAS=14
