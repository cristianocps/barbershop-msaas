# URL da API (vazio em produção = mesmo host via nginx)
VITE_API_URL=

# URL pública do app (vitrine). Vazio = usa o mesmo domínio do navegador (window.location.origin).
# Ex.: https://agendamento.minhabarbearia.com.br
VITE_PUBLIC_SITE_URL=

# Google OAuth — Web client ID (mesmo valor em GOOGLE_CLIENT_ID no backend)
VITE_GOOGLE_CLIENT_ID=
